{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-status.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__jira__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/jira-write-guard.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
